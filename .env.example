# Copy this file to .env and fill in real values. .env is gitignored.
# Reference: https://cube.dev/docs/reference/environment-variables

CUBEJS_DEV_MODE=true
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=localhost
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=semantic_layer
CUBEJS_DB_USER=cube
CUBEJS_DB_PASS=changeme

# Generate with: openssl rand -hex 64
CUBEJS_API_SECRET=changeme

CUBEJS_EXTERNAL_DEFAULT=true
CUBEJS_SCHEDULED_REFRESH_DEFAULT=true
CUBEJS_SCHEMA_PATH=model
CUBEJS_WEB_SOCKETS=true
